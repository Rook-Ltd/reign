#!/command/with-contenv sh
# shellcheck shell=sh
# Container-boot reconciliation of per-profile gateway s6 services.
#
# Runs as root after 01-reign-setup (the stage2 hook) has chowned
# the volume and seeded $REIGN_HOME, but before s6-rc starts user
# services. /etc/cont-init.d/* scripts run in lexicographic order,
# so the `02-` prefix guarantees ordering.
#
# Service directories live on tmpfs and are wiped on every container
# restart. Profile directories under $REIGN_HOME/profiles/ live on
# the persistent VOLUME. This script walks the persistent profiles,
# recreates the s6 service slots, and auto-starts only those whose
# last recorded state was `running` — see reign_cli/container_boot.py.
#
# Per-profile gateway slots are registered at runtime by the reign
# user (profile create/delete hooks, `reign gateway start`), so they
# live in their own scandir, $GATEWAY_SCANDIR, watched by an s6-svscan
# that itself runs as reign (the `profile-gateways` s6-rc service).
# The root scandir /run/service and its .s6-svscan control files stay
# root-owned: every slot in it is supervised by a root s6-supervise,
# which executes the slot's run/finish/log scripts as root.
set -e

GATEWAY_SCANDIR=/run/reign-service

if [ -L "$GATEWAY_SCANDIR" ]; then
    echo "[reconcile] refusing symlinked $GATEWAY_SCANDIR" >&2
    exit 1
fi
mkdir -p "$GATEWAY_SCANDIR"
chown reign:reign "$GATEWAY_SCANDIR"
chmod 0755 "$GATEWAY_SCANDIR"

# Skip the drop when already non-root.
[ "$(id -u)" = 0 ] || exec /opt/reign/.venv/bin/python -m reign_cli.container_boot
exec s6-setuidgid reign /opt/reign/.venv/bin/python -m reign_cli.container_boot
