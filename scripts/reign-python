#!/usr/bin/env bash
# Run Python in this checkout's environment: `scripts/reign-python ARGS...`.
#
# A GitHub Actions job runs the interpreter setup-pm exported as REIGN_PYTHON,
# so a recipe never re-runs setup on a runner. Anywhere else REIGN_PYTHON may
# be inherited from a wrapped `reign` (a release venv without the dev tools),
# so scripts/run-in-reign-env applies (and if stale, syncs) the environment
# `source ./activate` gives a shell.
set -euo pipefail

if [ "${GITHUB_ACTIONS:-}" = true ] && [ -z "${__REIGN_ACTIVATED:-}" ] && [ -n "${REIGN_PYTHON:-}" ] \
    && [ -x "$REIGN_PYTHON" ]; then
    exec "$REIGN_PYTHON" "$@"
fi
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/run-in-reign-env" python "$@"
